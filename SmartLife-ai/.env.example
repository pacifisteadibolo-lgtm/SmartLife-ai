# ── Copier ce fichier en .env et remplir les valeurs ──

SECRET_KEY=remplacez-par-une-cle-secrete-longue

# PostgreSQL
# En local : renseigne les variables ci-dessous.
# Sur Render : laisse-les vides, Render injecte DATABASE_URL automatiquement
# quand tu relies ta base PostgreSQL au service web.
DATABASE_URL=postgresql://user:password@localhost:5432/smartlife_ai
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartlife_ai

# IA (OpenAI ou autre)
AI_API_KEY=sk-...
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
